SPLUNK_HEC_URL=https://http-inputs-<stack>.splunkcloud.com:443   # Splunk Cloud: http-inputs-<stack>.splunkcloud.com (no /services/collector)
SPLUNK_HEC_TOKEN=<hec-token>
SPLUNK_METRICS_INDEX=caipe_metrics     # must be a METRICS-type index
SPLUNK_EVENTS_INDEX=caipe_events       # events index
SPLUNK_HEC_INSECURE_SKIP_VERIFY=false
CAIPE_ENV=prod
HASH_USER_IDS=false                    # true = sha256 the user email
POLL_INTERVAL=60
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
MONGODB_URI=
